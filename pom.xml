<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.oberon-oss</groupId>
        <artifactId>project-settings-parent</artifactId>
        <version>4.25.3</version>
    </parent>

    <groupId>eu.oberon-oss.tools</groupId>
    <artifactId>git-commit-in-log</artifactId>
    <version>1.0.2</version>

    <name>Incorporate git commit information into log messages</name>
    <description>Incorporate git commit information into log messages</description>

    <properties>
        <sonar.projectKey>oberon-oss_git-commit-in-log</sonar.projectKey>

        <sonar.issue.ignore.multicriteria>s7637</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.s7637.ruleKey>githubactions:S7637</sonar.issue.ignore.multicriteria.s7637.ruleKey>
        <sonar.issue.ignore.multicriteria.s7637.resourceKey>.github/workflows/**</sonar.issue.ignore.multicriteria.s7637.resourceKey>
        <!--suppress XmlUnresolvedReference -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- other dependencies -->
        <dependency>
            <groupId>eu.oberon-oss.tools</groupId>
            <artifactId>converters</artifactId>
            <version>1.2.0</version>
        </dependency>

    </dependencies>

    <repositories>
        <repository>
            <id>nexus-releases</id>
            <name>Nexus Release Repository</name>
            <url>https://nexus.oberon-oss.eu/repository/maven-releases/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>

        <repository>
            <id>nexus-snapshots</id>
            <url>https://nexus.oberon-oss.eu/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>